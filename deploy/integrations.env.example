# Append selected settings to the existing private /etc/personal-os.env.
# Do not replace its APP_ORIGIN, database path or setup token.
# Generate encryption/VAPID keys with server/provision.mjs; keep values private.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ASSISTANT_FREE_DAILY_LIMIT=20
ASSISTANT_PRO_DAILY_LIMIT=200
ASSISTANT_SERVER_DAILY_LIMIT=200
ASSISTANT_BUDGET_TIMEZONE=Africa/Cairo
ASSISTANT_MAX_TOKENS=4096
ASSISTANT_CONTEXT_CHAR_LIMIT=24000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paid checkout is deliberately off and is independent of Claude access.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
