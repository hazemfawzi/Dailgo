NODE_ENV=production
APP_ORIGIN=https://assistant.example.com
PORT=8787
PERSONAL_OS_DB=/var/lib/personal-os/workspace.sqlite
# Generate a random private value locally on the server. Never put it in Vite/client variables.
# Removing it after creating the account disables first-account setup if the database is absent.
PERSONAL_OS_SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
