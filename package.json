{
  "name": "personal-os-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node scripts/test.mjs",
    "server": "node scripts/build-server.mjs && node server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:server": "node scripts/build-server.mjs && node --test scripts/server.test.mjs",
    "test:browser": "node scripts/build-server.mjs && playwright test",
    "test:deploy": "python3 -B -m unittest discover -s tests/deploy -v",
    "test:features": "node scripts/build-server.mjs && node --test scripts/features.test.mjs",
    "test:production": "node scripts/build-server.mjs && playwright test --config playwright.production.config.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:core": "node scripts/build-server.mjs && node --test scripts/core-flow.test.mjs",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "adhan": "^4.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.19.x"
  }
}
